# Minimal 9Router sidecar configuration.
# Compose sets DATA_DIR, PORT, NODE_ENV and TENANT_MODE automatically.
JWT_SECRET=replace-with-a-unique-random-secret
INITIAL_PASSWORD=replace-with-a-strong-admin-password

# Must exactly match ROUTER_SECRET in XBot's root .env (minimum 32 characters).
ROUTER_SECRET=replace-with-one-shared-random-secret-at-least-32-characters

# Optional dedicated AES-256-GCM tenant vault key. If omitted, ROUTER_SECRET is
# used as key material. Rotating either value requires a credential migration.
# NINEROUTER_VAULT_KEY=replace-with-unique-random-key-material-at-least-32-characters

# Operator-owned Google OAuth Web application clients for xBot HTTPS callbacks.
# Do not copy upstream's bundled public/native client material.
# ANTIGRAVITY_OAUTH_CLIENT_ID=your_registered_client_id
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=your_registered_client_secret
# GEMINI_OAUTH_CLIENT_ID=your_registered_client_id
# GEMINI_OAUTH_CLIENT_SECRET=your_registered_client_secret
